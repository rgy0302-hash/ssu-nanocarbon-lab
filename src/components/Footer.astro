---
import site from '../data/site.json';
import nav from '../data/navigation.json';
import { url } from '../lib/paths';
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__name">{site.labNameKo}<span>{site.labNameEn}</span></p>
      <address>
        {site.address}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={`tel:${site.phoneLink}`}>{site.phone}</a>
      </address>
    </div>
    <nav aria-label="바닥글 메뉴">
      <ul class="site-footer__links">
        {nav.filter((n: any) => n.href !== '/').map((n: any) => <li><a href={url(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container"><p class="site-footer__copy">{site.copyright}</p></div>
</footer>
