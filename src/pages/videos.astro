---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import data from '../data/videos.json';
import { formatDate } from '../lib/content';
---
<BaseLayout title="Videos" description="나노탄소재료 연구실 연구 영상">
  <PageHeader title="Videos" crumbs={[{ label: 'Videos' }]}>
    {data.intro.map((t) => <p class="page-head__sub" lang="en">{t}</p>)}
  </PageHeader>
  <section class="section">
    <div class="container video-grid">
      {data.videos.map((v) => (
        <article class="video">
          <div class="video__frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}?rel=0`}
              title={`YouTube 동영상: ${v.title}`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          </div>
          <h2 lang="en">{v.title}</h2>
          <p>
            {v.date && <><time datetime={v.date}>{formatDate(v.date)}</time> · </>}
            <a href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">YouTube에서 보기<span class="sr-only"> (새 창)</span></a>
          </p>
          {v.description && <p>{v.description}</p>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
