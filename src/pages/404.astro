---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
---
<BaseLayout title="페이지를 찾을 수 없습니다" noindex>
  <section class="section">
    <div class="container narrow" style="text-align:center">
      <span class="eyebrow">404</span>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p class="muted">주소가 바뀌었거나 삭제된 페이지입니다. 아래 메뉴에서 원하시는 페이지로 이동해 주세요.</p>
      <p style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <a class="btn" href={url('/')}>홈으로</a>
        <a class="btn btn--ghost" href={url('/publications/papers/')}>논문</a>
        <a class="btn btn--ghost" href={url('/members/')}>구성원</a>
        <a class="btn btn--ghost" href={url('/contact/')}>연락처</a>
      </p>
    </div>
  </section>
</BaseLayout>
