---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';
import { url } from '../lib/paths';
const q = encodeURIComponent(site.mapQuery);
const downloads = site.contact.downloads as { label: string; file: string }[];
---
<BaseLayout title="Contact us" description="나노탄소재료 연구실 연락처, 위치, 학부연구생·대학원생 지원 문의">
  <PageHeader title="Contact us" subtitle={site.labNameEn} crumbs={[{ label: 'Contact us' }]} />
  <section class="section">
    <div class="container contact-grid">
      <div>
        {site.contact.intro.map((t) => <p>{t}</p>)}
        <p><strong>{site.contact.recruit}</strong></p>
        {downloads.length > 0 && (
          <div class="attachments" style="margin:0 0 24px">
            <h2>연구 소개 자료 다운로드</h2>
            <ul>{downloads.map((f) => <li><a href={url(f.file)} download>{f.label}</a></li>)}</ul>
          </div>
        )}
        <dl class="info-list">
          <div><dt>이메일</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>전화</dt><dd><a href={`tel:${site.phoneLink}`}>{site.phone}</a></dd></div>
          <div><dt>주소</dt><dd>{site.address}</dd></div>
          <div><dt>연구실</dt><dd>{site.office}</dd></div>
        </dl>
        <div class="map-links">
          <a class="btn btn--ghost" href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener">네이버 지도<span class="sr-only"> (새 창)</span></a>
          <a class="btn btn--ghost" href={`https://map.kakao.com/?q=${q}`} target="_blank" rel="noopener">카카오맵<span class="sr-only"> (새 창)</span></a>
          <a class="btn btn--ghost" href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener">Google 지도<span class="sr-only"> (새 창)</span></a>
        </div>
      </div>

      <div>
        <h2>이메일로 문의하기</h2>
        <p class="form-hint">아래 내용을 입력하고 버튼을 누르면 <strong>사용하시는 이메일 앱이 열리고</strong> 내용이 미리 채워집니다. 실제 발송은 이메일 앱에서 ‘보내기’를 눌러야 완료됩니다.</p>
        <form class="form" data-mailto={site.email} novalidate>
          <div>
            <label for="c-name">이름 / 소속</label>
            <input id="c-name" name="name" class="input" autocomplete="name" />
          </div>
          <div>
            <label for="c-type">문의 유형</label>
            <select id="c-type" name="type" class="select">
              <option>일반 문의</option>
              <option>학부연구생 지원</option>
              <option>대학원 진학</option>
              <option>산학협력 · 연구 협력</option>
            </select>
          </div>
          <div>
            <label for="c-msg">문의 내용</label>
            <textarea id="c-msg" name="message" class="input"></textarea>
          </div>
          <button class="btn" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            이메일 앱 열기
          </button>
          <p class="form-status" role="status" data-status></p>
          <p class="form-hint">이메일 앱이 열리지 않으면 <a href={`mailto:${site.email}`}>{site.email}</a> 로 직접 보내 주세요.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-mailto]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const type = String(fd.get('type') || '문의');
    const name = String(fd.get('name') || '').trim();
    const msg = String(fd.get('message') || '').trim();
    const subject = `[홈페이지 문의] ${type}${name ? ' - ' + name : ''}`;
    const body = `${msg}\n\n---\n이름/소속: ${name}`;
    const href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const status = form.querySelector<HTMLElement>('[data-status]');
    if (status) status.textContent = '이메일 앱을 여는 중입니다. 발송은 이메일 앱에서 직접 완료해 주세요.';
    window.location.href = href;
  });
</script>
