---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Img from '../components/Img.astro';
import images from '../data/images.json';
import professor from '../data/professor.json';
import { getResearch } from '../lib/content';
import { url } from '../lib/paths';
import * as about from '../content/pages/about.md';

const research = getResearch();
---
<BaseLayout title="About us" description="나노탄소재료 연구실 소개 — 탄소나노튜브 섬유·필름 연속 제조 기술과 응용 연구">
  <PageHeader title="About us" subtitle="Nano Carbon Materials Lab · 나노탄소재료 연구실" crumbs={[{ label: 'About us' }]} />
  <section class="section">
    <div class="container about-intro">
      <div class="prose">
        <span class="eyebrow">About Us.</span>
        <h2>{about.frontmatter.heading}</h2>
        <div class="lead"><about.Content /></div>
        <p style="display:flex;gap:18px;flex-wrap:wrap;margin:0"><a class="text-link" href={url('/research/')}>연구 분야</a><a class="text-link" href={url('/members/professor/')}>교수 소개</a><a class="text-link" href={url('/contact/')}>Contact us</a></p>
      </div>
      <Img src={images.aboutBanner.src} alt={images.aboutBanner.alt} ratio="16 / 10" focus={images.aboutBanner.focus} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head"><h2>연구 이미지</h2></div>
      <div class="figure-grid">
        {images.aboutFigures.map((f) => (
          <Img src={f.src} alt={f.alt} caption={f.caption} fit="contain" ratio="4 / 3" lightbox="about" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>주요 연구 분야</h2>
        <ul class="check-list">
          {professor.researchInterests.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div>
        <h2>연구 페이지</h2>
        <ul class="news-list">
          {research.map((r) => <li><a href={url(`/research/${r.slug}/`)}><time>{r.titleKo}</time>{r.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
