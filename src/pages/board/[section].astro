---
/*
 * 보조 주소: /board/notice/, /board/gallery/, /board/videos/
 * 메뉴가 Board 아래로 묶이면서 방문자가 이런 주소를 입력해도 기존 페이지로 이동하도록 연결합니다.
 * 실제 페이지 주소(/notice/, /gallery/, /videos/)는 바뀌지 않았습니다.
 */
import { url } from '../../lib/paths';
export function getStaticPaths() {
  return [
    { params: { section: 'notice' }, props: { to: '/notice/', label: 'Notice' } },
    { params: { section: 'gallery' }, props: { to: '/gallery/', label: 'Gallery' } },
    { params: { section: 'videos' }, props: { to: '/videos/', label: 'Videos' } },
  ];
}
const { to, label } = Astro.props;
const target = url(to);
const canonical = Astro.site ? new URL(target, Astro.site).href : target;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{label} 페이지로 이동</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{label} 페이지로 이동</a></p>
    <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
  </body>
</html>
