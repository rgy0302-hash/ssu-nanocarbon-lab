---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import site from '../data/site.json';
import images from '../data/images.json';
import papers from '../data/papers.json';
import patents from '../data/patents.json';
import members from '../data/members.json';
import alumni from '../data/alumni.json';
import gallery from '../data/gallery.json';
import { getResearch, getNotices, formatDate } from '../lib/content';
import { url } from '../lib/paths';

const research = getResearch();
const notices = getNotices().slice(0, 4);
// 최신 논문: 연도 내림차순 → 원본 목록 순서
const latestPapers = papers.map((p, i) => ({ ...p, i })).sort((a, b) => b.year - a.year || a.i - b.i).slice(0, 5);
const albums = gallery.albums.slice(0, 4);
const stats = [
  { n: papers.length, label: '논문', href: '/publications/papers/' },
  { n: patents.length, label: '특허 (국내·해외 출원)', href: '/publications/patents/' },
  { n: members.members.length, label: '현재 학생 구성원', href: '/members/current/' },
  { n: alumni.length, label: '졸업생', href: '/members/alumni/' },
];
const q = encodeURIComponent(site.mapQuery);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">{site.affiliation}</span>
        <h1>{site.labNameEn}</h1>
        <p class="hero__ko">{site.labNameKo}</p>
        <div class="hero__intro">
          <p class="muted">{site.home.welcome}</p>
          {site.home.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="hero__actions">
          <a class="btn" href={url('/research/')}>연구 분야 보기</a>
          <a class="btn btn--ghost" href={url('/about/')}>연구실 소개</a>
        </div>
      </div>
      <Img src={images.homeHero.src} alt={images.homeHero.alt} ratio="4 / 3" focus={images.homeHero.focus} loading="eager" />
    </div>
    <div class="container">
      <div class="stats" aria-label="웹사이트에 등록된 자료 수">
        {stats.map((s) => <a href={url(s.href)}><strong>{s.n}</strong>{s.label}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Research</span><h2>주요 연구 분야</h2></div>
        <a class="text-link" href={url('/research/')}>전체 연구 분야</a>
      </div>
      <div class="areas">
        {research.map((r) => (
          <article class="area">
            <Img src={r.cover?.src} alt={r.cover?.alt || r.title} ratio="4 / 3" />
            <div>
              <h3><a href={url(`/research/${r.slug}/`)}>{r.title}</a></h3>
              <p class="area__ko">{r.titleKo}</p>
            </div>
            <p>{r.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container two-col">
      <div>
        <div class="section-head">
          <div><span class="eyebrow">Publication</span><h2>최신 논문</h2></div>
          <a class="text-link" href={url('/publications/papers/')}>논문 {papers.length}편 전체 보기</a>
        </div>
        <ol class="pub-list">
          {latestPapers.map((p) => (
            <li class="pub" style="grid-template-columns:3.2em 1fr">
              <span class="pub__no">{p.year}</span>
              <div>
                <p class="pub__title">{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title}<span class="sr-only"> (새 창)</span></a> : p.title}</p>
                <p class="pub__venue">{p.journal && <em>{p.journal}</em>}{p.detail && `, ${p.detail}`}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <div class="section-head">
          <div><span class="eyebrow">Notice</span><h2>공지사항</h2></div>
          <a class="text-link" href={url('/notice/')}>전체 보기</a>
        </div>
        {notices.length ? (
          <ul class="news-list">
            {notices.map((n) => (
              <li><a href={url(`/notice/${n.slug}/`)}><time datetime={n.date}>{formatDate(n.date)}</time>{n.title}</a></li>
            ))}
          </ul>
        ) : (
          <div class="empty"><p>등록된 공지사항이 없습니다.</p></div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Gallery</span><h2>연구실 소식</h2></div>
        <a class="text-link" href={url('/gallery/')}>갤러리 전체 보기</a>
      </div>
      <div class="gallery-preview">
        {albums.map((a) => (
          <a href={url(`/gallery/#${a.id}`)}>
            <Img src={a.photos[0]?.src} alt={a.photos[0]?.alt || a.title} ratio="4 / 3" focus={a.photos[0]?.focus} />
            <span>{a.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft section--tight">
    <div class="container contact-strip">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>연락처 및 위치</h2>
        <p class="muted">{site.contact.recruit}</p>
        <a class="btn" href={url('/contact/')}>문의 안내 보기</a>
      </div>
      <div>
        <dl class="info-list">
          <div><dt>주소</dt><dd>{site.address}</dd></div>
          <div><dt>연구실</dt><dd>{site.office}</dd></div>
          <div><dt>이메일</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>전화</dt><dd><a href={`tel:${site.phoneLink}`}>{site.phone}</a></dd></div>
        </dl>
        <div class="map-links">
          <a class="btn btn--ghost" href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener">네이버 지도<span class="sr-only"> (새 창)</span></a>
          <a class="btn btn--ghost" href={`https://map.kakao.com/?q=${q}`} target="_blank" rel="noopener">카카오맵<span class="sr-only"> (새 창)</span></a>
          <a class="btn btn--ghost" href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener">Google 지도<span class="sr-only"> (새 창)</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
