---
/*
 * 홈 화면
 * 화면에 보이는 글·숫자는 모두 데이터 파일에서 가져옵니다(이 파일에는 내용이 없습니다).
 *   소개문        src/data/site.json → home
 *   대표 이미지    src/data/images.json → homeHero
 *   연구 분야      src/content/research/*.md
 *   논문·특허 등   src/data/papers.json, patents.json, members.json, alumni.json
 *   최근 소식      공지·갤러리·동영상(Board)에서 자동으로 최신 4개 → 없으면 영역이 숨겨집니다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import site from '../data/site.json';
import images from '../data/images.json';
import papers from '../data/papers.json';
import patents from '../data/patents.json';
import members from '../data/members.json';
import alumni from '../data/alumni.json';
import { getResearch } from '../lib/content';
import { getBoardItems } from '../lib/board';
import { url } from '../lib/paths';

const RECENT_LIMIT = 4; // 홈 '최근 소식' 개수 (3~4 권장)
const research = getResearch();
const recent = getBoardItems().slice(0, RECENT_LIMIT);
// 최신 논문: 연도 내림차순 → 같은 연도는 파일 순서
const latestPapers = papers.map((p, i) => ({ ...p, i })).sort((a, b) => b.year - a.year || a.i - b.i).slice(0, 5);
const stats = [
  { n: papers.length, label: '논문', href: '/publications/papers/' },
  { n: patents.length, label: '특허 (국내·해외 출원)', href: '/publications/patents/' },
  { n: members.members.length, label: '현재 학생 구성원', href: '/members/current/' },
  { n: alumni.length, label: '졸업생', href: '/members/alumni/' },
];
---
<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <div class="container hero__grid">
      <div class="home-about">
        <span class="eyebrow">{site.affiliation}</span>
        <div>
          <h1 id="home-title">{site.labNameEn}</h1>
          <p class="hero__ko">{site.labNameKo}</p>
        </div>
        <div class="hero__intro">
          <p class="muted">{site.home.welcome}</p>
          {site.home.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="hero__actions">
          <a class="btn" href={url('/about/')}>연구실 소개 (About us)</a>
          <a class="btn btn--ghost" href={url('/research/')}>연구 분야</a>
        </div>
      </div>
      <Img src={images.homeHero.src} alt={images.homeHero.alt} ratio="4 / 3" focus={images.homeHero.focus} loading="eager" />
    </div>
    <div class="container">
      <div class="stats" aria-label="연구 성과와 구성원 (웹사이트 등록 기준)">
        {stats.map((s) => <a href={url(s.href)}><strong>{s.n}</strong>{s.label}</a>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="home-research">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Research</span><h2 id="home-research">주요 연구 분야</h2></div>
        <a class="text-link" href={url('/research/')}>전체 연구 분야</a>
      </div>
      <div class="areas">
        {research.map((r) => (
          <article class="area">
            <Img src={r.cover?.src} alt={r.cover?.alt || r.title} ratio="4 / 3" />
            <div>
              <h3><a href={url(`/research/${r.slug}/`)}>{r.title}</a></h3>
              <p class="area__ko">{r.titleKo}</p>
            </div>
            <p>{r.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class:list={['container', { 'two-col': recent.length > 0 }]}>
      <div>
        <div class="section-head">
          <div><span class="eyebrow">Publications</span><h2>최신 논문</h2></div>
          <a class="text-link" href={url('/publications/papers/')}>논문 {papers.length}편 전체 보기</a>
        </div>
        <ol class="pub-list">
          {latestPapers.map((p) => (
            <li class="pub" style="grid-template-columns:3.2em 1fr">
              <span class="pub__no">{p.year}</span>
              <div>
                <p class="pub__title">{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title}<span class="sr-only"> (새 창)</span></a> : p.title}</p>
                <p class="pub__venue">{p.journal && <em>{p.journal}</em>}{p.detail && `, ${p.detail}`}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      {recent.length > 0 && (
        <div>
          <div class="section-head">
            <div><span class="eyebrow">Board</span><h2>최근 소식</h2></div>
            <a class="text-link" href={url('/board/')}>Board 전체 보기</a>
          </div>
          <ul class="recent-list">
            {recent.map((it) => (
              <li>
                <a href={url(it.href)}>
                  <span class:list={['tag', `tag--${it.type}`]}>{it.typeLabel}</span>
                  <span class="recent-list__title">{it.title}</span>
                  {it.date && <time datetime={it.datetime}>{it.date}</time>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
